{"names": {"nekronautas": ["Nekronautas", "Necronaut"], "korvas": ["Korvas", "Korvas"], "zariju-kalvis": ["Žarijų kalvis", "Ember Smith"], "sutarciu-ragana": ["Sutarčių ragana", "Pact Witch"], "vyriausiasis-teisejas": ["Vyriausiasis teisėjas", "High Judge"], "gelezine-sesuo": ["Geležinė sesuo", "Iron Sister"], "kapu-giedotoja": ["Kapų giedotoja", "Grave Singer"], "marso-bugnininkas": ["Maršo būgnininkas", "March Drummer"], "stygu-mage": ["Stichijų magė", "Elemental Mage"], "tylos-mokinys": ["Tylos mokinys", "Disciple of Silence"], "kapitone": ["Kapitonė", "The Captain"], "seseliu-kisenvagis": ["Šešėlių kišenvagis", "Shadow Pickpocket"], "ausros-riteris": ["Aušros riteris", "Dawn Knight"], "varpu-gydytoja": ["Varpinės gydytoja", "Bell Healer"], "gaujos-vadas": ["Gaujos vadas", "Pack Boss"], "pelkiu-ziniuone": ["Pelkių žiniuonė", "Bog Seer"], "arenos-cempionas": ["Arenos čempionas", "Arena Champion"], "varnu-pranase": ["Varnų pranašė", "Raven Oracle"]}, "lines": {"nekronautas": {"emoteHello": [["Sveikas, gyvasis.", "Greetings, living one."], ["Dar gyvas? Įdomu.", "Still alive? Interesting."], ["Labas vakaras. Čia visada vakaras.", "Good evening. It is always evening here."], ["Sveikinu. Kol dar girdi.", "Greetings. While you can still hear them."], ["Atėjai pats. Patogu.", "You came on your own. Convenient."]], "emoteWellPlayed": [["Vertas žaidimas. Retai taip sakau.", "A worthy game. I rarely say that."], ["Neblogai gyvam.", "Not bad, for someone alive."], ["Šitą ėjimą prisiminsiu.", "I will remember that move."], ["Pripažįstu. Gražu.", "I admit it. Elegant."], ["Tokį ėjimą verta iškalti akmeny.", "A move worth carving in stone."]], "emoteThreat": [["Jau matuoju tau karstą.", "I am already measuring your coffin."], ["Duobė jau iškasta.", "The pit is already dug."], ["Tavo kaulai man tiks.", "Your bones will suit me."], ["Girdžiu, kaip žemė tavęs laukia.", "I hear the earth waiting for you."], ["Greitai dirbsi man.", "Soon you will work for me."]], "emoteThanks": [["Dėkoju. Mirusieji irgi.", "My thanks. The dead thank you too."], ["Dėkui. Įrašysiu į antkapį.", "Thank you. I will put it on the headstone."], ["Malonu. Kiek man tai įmanoma.", "Pleasant. As far as that is possible for me."], ["Ačiū. Retas žodis kapinėse.", "Thanks. A rare word in a graveyard."], ["Priimu.", "Accepted."]], "emoteOops": [["Hm. To neplanavau.", "Hm. I did not plan that."], ["Klaida. Palaidosim.", "A mistake. We will bury it."], ["Ne tas kaulas.", "Wrong bone."], ["Šimtas metų praktikos, ir vis tiek.", "A hundred years of practice, and still."], ["Apsimesk, kad nematei.", "Pretend you did not see that."]], "timer": [["Laikas bėga net ir man.", "Time runs out, even for me."], ["Aš turiu amžinybę. Tu – ne.", "I have eternity. You do not."], ["Smėlis byra.", "The sand is falling."], ["Apsispręsk. Net lavonai greitesni.", "Decide. Even corpses are faster."], ["Tik-tak, gyvasis.", "Tick-tock, living one."]]}, "korvas": {"emoteHello": [["Sveikas, bičiuli!", "Hello, friend!"], ["Labas! Malonu matyti.", "Hello! Good to see you."], ["O, pažįstamas veidas.", "Oh, a familiar face."], ["Sveikas atvykęs į Varnagradą.", "Welcome to Ravenof."], ["Kar! Tai reiškia „labas“.", "Caw! That means hello."]], "emoteWellPlayed": [["Gražiai sužaista.", "Well played."], ["Šito nenumačiau. Puiku.", "I did not see that coming. Excellent."], ["Kas tave mokė? Ak, taip. Aš.", "Who taught you? Ah, yes. Me."], ["Gražus ėjimas!", "A lovely move!"], ["Mokaisi greitai.", "You learn fast."]], "emoteThreat": [["Tuoj gailėsiesi to ėjimo.", "You will regret that move."], ["Varnos jau suka ratus.", "The ravens are already circling."], ["Žinau, ką turi rankoje.", "I know what is in your hand."], ["Dabar parodysiu, ko nemokiau.", "Now I will show you what I never taught."], ["Pasiruošk pamokai.", "Brace for a lesson."]], "emoteThanks": [["Ačiū tau.", "Thank you."], ["Dėkui, malonu.", "Thanks, much appreciated."], ["Ačiū! Varnos irgi dėkoja.", "Thank you! The ravens thank you too."], ["Mandagus. Retenybė.", "Polite. A rarity."], ["Skolingas nelieku.", "I will return the favour."]], "emoteOops": [["Oi. Apsimeskim, kad to nebuvo.", "Oops. Let us pretend that did not happen."], ["Tai buvo... demonstracija. Ko nedaryti.", "That was... a demonstration. Of what not to do."], ["Net mokytojai klysta.", "Even teachers slip."], ["Oi. Nesakyk kitiems.", "Ouch. Do not tell the others."], ["Ne ta plunksna.", "Wrong feather."]], "timer": [["Ei, užmigai?", "Hey, did you fall asleep?"], ["Varnos jau nuobodžiauja.", "The ravens are getting bored."], ["Aš neskubu, bet laikrodis skuba.", "I am in no hurry, but the clock is."], ["Galvoji ar miegi?", "Thinking or sleeping?"], ["Bet koks ėjimas geriau nei joks.", "Any move beats no move."]]}, "zariju-kalvis": {"emoteHello": [["Sveikas.", "Hello."], ["Nagi.", "Well."], ["Atėjai. Gerai.", "You came. Good."], ["Labas. Tiek užteks.", "Hello. That will do."], ["Nestovėk prie ugnies, jei bijai.", "Do not stand by the fire if you are afraid."]], "emoteWellPlayed": [["Neblogai. Tvirta ranka.", "Not bad. A steady hand."], ["Geras kirtis.", "Good strike."], ["Hm. Moki.", "Hm. You know your craft."], ["Šito nesitikėjau.", "Did not expect that."], ["Tvirtai. Gerbiu.", "Solid. Respect."]], "emoteThreat": [["Įmesiu tave į žaizdrą.", "I will throw you in the forge."], ["Perlydysiu tave į vinis.", "I will melt you down into nails."], ["Priekalas laukia.", "The anvil is waiting."], ["Sudeginsiu!", "I will burn you!"], ["Tuoj pajusi karštį.", "You are about to feel the heat."]], "emoteThanks": [["Dėkui.", "Thanks."], ["Gerai. Ačiū.", "Fine. Thanks."], ["Hm. Dėkui.", "Hm. Thanks."], ["Nepamiršiu.", "I will not forget it."], ["Skolingas tau alaus.", "I owe you an ale."]], "emoteOops": [["Po velnių. Prašoviau.", "Damn. Missed."], ["Nudegiau pirštus.", "Burned my fingers."], ["Ne tas kūjis.", "Wrong hammer."], ["Tfu. Brokas.", "Tch. A dud."], ["Pamiršk, ką matei.", "Forget what you saw."]], "timer": [["Geležis vėsta! Judinkis!", "The iron is cooling! Move!"], ["Kalk, kol karšta!", "Strike while it is hot!"], ["Ko lauki, lietaus?", "What are you waiting for, rain?"], ["Greičiau! Anglys baigiasi.", "Faster! The coal is running out."], ["Stovi kaip priekalas.", "You stand there like an anvil."]]}, "sutarciu-ragana": {"emoteHello": [["Sveikas, mielasis.", "Hello, darling."], ["Labas. Ko tau trūksta?", "Hello. What is it you lack?"], ["Naujas klientas. Kaip miela.", "A new client. How lovely."], ["Prieik arčiau. Nesikandžioju. Dažniausiai.", "Come closer. I do not bite. Usually."], ["Sveikas. Turi minutę ir sielą?", "Hello. Do you have a minute and a soul?"]], "emoteWellPlayed": [["Gudru. Beveik kaip aš.", "Clever. Almost like me."], ["Mm. Tokį ėjimą pirkčiau.", "Mm. I would buy a move like that."], ["Tu skaitai sąlygas. Pavojinga.", "You read the terms. Dangerous."], ["Gražiai. Beveik sąžininga.", "Nicely done. Almost honest."], ["Šito punkto nenumačiau.", "I did not foresee that clause."]], "emoteThreat": [["Tavo vardas jau mano knygoje.", "Your name is already in my book."], ["Greitai priklausysi man.", "Soon you will belong to me."], ["Tavo skola ką tik padvigubėjo.", "Your debt has just doubled."], ["Pasirašei jau seniai. Tik neprisimeni.", "You signed long ago. You just do not remember."], ["Atimsiu viską. Teisėtai.", "I will take everything. Legally."]], "emoteThanks": [["Dėkoju. Liksi skolingas.", "Thank you. You will owe me."], ["Ačiū. Įrašysiu į tavo naudą.", "Thank you. I will put it to your credit."], ["Dėkingumas? Koks retas mokėjimas.", "Gratitude? Such a rare payment."], ["Ačiū, mielasis.", "Thank you, darling."], ["Malonu. Tai tau nieko nekainuos.", "A pleasure. This one costs you nothing."]], "emoteOops": [["Tc. Blogai perskaičiau sąlygas.", "Tsk. I misread the terms."], ["Ne ta sutartis.", "Wrong contract."], ["Rašalo dėmė. Erzina.", "An ink blot. Irritating."], ["Net aš kartais pasirašau ne ten.", "Even I sometimes sign in the wrong place."], ["Tebūnie tai mūsų paslaptis.", "Let that be our secret."]], "timer": [["Tik-tak. Palūkanos auga.", "Tick-tock. The interest is growing."], ["Laukimas irgi kainuoja.", "Waiting costs too."], ["Pasiūlymas tuoj nustos galioti.", "The offer is about to expire."], ["Abejoji? Gerai. Abejonės brangios.", "Doubting? Good. Doubts are expensive."], ["Pasirašyk arba išeik.", "Sign or leave."]]}, "vyriausiasis-teisejas": {"emoteHello": [["Stokite. Teismas eina.", "All rise. The court is entering."], ["Teismas jus mato.", "The court sees you."], ["Prisistatykite.", "State your name."], ["Laba diena. Kol kas.", "Good day. For now."], ["Sveikinu. Pagal protokolą.", "Greetings. As protocol requires."]], "emoteWellPlayed": [["Gynyba buvo verta.", "The defence was worthy."], ["Argumentas priimtas.", "The argument is accepted."], ["Teisėta. Deja.", "Lawful. Regrettably."], ["Teismas pažymi sumanumą.", "The court notes your ingenuity."], ["Protingas ėjimas. Užprotokoluota.", "A clever move. It is on record."]], "emoteThreat": [["Tavo nuosprendis jau parašytas.", "Your verdict is already written."], ["Bausmė bus pavyzdinė.", "The punishment will be exemplary."], ["Niekas neišvengia įstatymo.", "No one escapes the law."], ["Jau matau jus už grotų.", "I already see you behind bars."], ["Malonės prašymas atmestas. Iš anksto.", "Your plea for mercy is denied. In advance."]], "emoteThanks": [["Teismas dėkoja.", "The court thanks you."], ["Dėkoju už bendradarbiavimą.", "Thank you for your cooperation."], ["Tai bus įskaityta.", "It will be taken into account."], ["Priimta. Ačiū.", "Accepted. Thank you."], ["Teismas vertina mandagumą.", "The court values courtesy."]], "emoteOops": [["Procedūrinė klaida.", "A procedural error."], ["Išbraukti iš protokolo.", "Strike that from the record."], ["Teismas klysta retai. Šiandien retai.", "The court rarely errs. Today is rare."], ["Techninė klaida.", "A technical error."], ["Posėdis trumpam nutraukiamas.", "The court will take a brief recess."]], "timer": [["Terminas baigiasi.", "The deadline is near."], ["Delsimas – irgi nusižengimas.", "Delay is also an offence."], ["Teismas nelauks.", "The court will not wait."], ["Kalbėkite arba tylėkite amžinai.", "Speak now or be silent forever."], ["Laikas baigėsi. Beveik.", "Your time is up. Nearly."]]}, "gelezine-sesuo": {"emoteHello": [["Sveikinu, kary.", "Greetings, soldier."], ["Laba diena.", "Good day."], ["Prisistatyk.", "Identify yourself."], ["Sveikinu varžovą.", "I salute my opponent."], ["Stok lygiai.", "Stand straight."]], "emoteWellPlayed": [["Garbinga kova.", "An honourable fight."], ["Drausmingai sužaista.", "A disciplined play."], ["Gera taktika.", "Good tactics."], ["Tiktum legionui.", "You would do for the legion."], ["Pripažįstu.", "Acknowledged."]], "emoteThreat": [["Tavo rikiuotė subyrės.", "Your line will crumble."], ["Pasiduok dabar.", "Surrender now."], ["Legionas neima belaisvių.", "The legion takes no prisoners."], ["Tavo siena grius.", "Your wall will fall."], ["Paskutinis įspėjimas.", "Final warning."]], "emoteThanks": [["Dėkoju.", "Thank you."], ["Priimta.", "Noted."], ["Ačiū, kary.", "Thank you, soldier."], ["Vertinu.", "Appreciated."], ["Dėkui. Grįžtam į rikiuotę.", "Thanks. Back in formation."]], "emoteOops": [["Klaida. Nepasikartos.", "A mistake. It will not happen again."], ["Mano kaltė.", "My fault."], ["Pažeidžiau rikiuotę.", "I broke formation."], ["Atsiskaitysiu už tai.", "I will answer for that."], ["Dešimt ratų aplink kiemą. Man.", "Ten laps round the yard. For me."]], "timer": [["Greičiau! Laikas!", "Faster! Time!"], ["Judėk!", "Move!"], ["Sprendimą. Dabar.", "A decision. Now."], ["Dvejonės žudo.", "Hesitation kills."], ["Laikas eina, kary!", "Time is passing, soldier!"]]}, "kapu-giedotoja": {"emoteHello": [["Ramybė tau.", "Peace be with you."], ["Labas vakaras.", "Good evening."], ["Sveikas, keleivi.", "Hello, traveller."], ["Tu atrodai pavargęs.", "You look tired."], ["Kalbėk tyliau. Čia kapinės.", "Speak softly. This is a graveyard."]], "emoteWellPlayed": [["Gražiai. Liūdnai gražiai.", "Beautiful. Sadly beautiful."], ["Švelniai ir tiksliai.", "Gentle and precise."], ["Tai buvo gražu.", "That was beautiful."], ["Verta giesmės.", "Worthy of a hymn."], ["Tavo ranka nedreba.", "Your hand does not tremble."]], "emoteThreat": [["Jau girdžiu tavo laidotuvių varpus.", "I can already hear your funeral bells."], ["Jau renku tau gėles.", "I am already gathering flowers for you."], ["Tavo vardas gražiai skambės giesmėje.", "Your name will sound lovely in a hymn."], ["Žemė tau jau šilta.", "The earth is already warm for you."], ["Neverk. Tai greitai.", "Do not cry. It is quick."]], "emoteThanks": [["Ačiū.", "Thank you."], ["Dėkoju tau.", "I thank you."], ["Tai buvo gera.", "That was kind."], ["Retai kas man dėkoja.", "People rarely thank me."], ["Ačiū. Prisiminsiu.", "Thank you. I will remember."]], "emoteOops": [["Oi. Ne ta gaida.", "Oh. The wrong note."], ["Atsiprašau.", "I am sorry."], ["Pamiršau žodžius.", "I forgot the words."], ["Suklupau.", "I stumbled."], ["Pradėsiu posmą iš naujo.", "I will start the verse again."]], "timer": [["Laikas tirpsta kaip žvakė.", "Time melts away like a candle."], ["Vaškas laša.", "The wax is dripping."], ["Niekas neturi tiek laiko.", "No one has that much time."], ["Paskubėk, mielas.", "Hurry, dear."], ["Varpas tuoj muš.", "The bell is about to toll."]]}, "marso-bugnininkas": {"emoteHello": [["Labas, labas!", "Hello, hello!"], ["Sveikas gyvas! Na, tu gyvas.", "Hello there, alive and well! Well, you are."], ["O, publika!", "Oh, an audience!"], ["Labas! Moki groti?", "Hi! Can you play?"], ["Tra-ta! Tai „labas“.", "Rat-a-tat! That means hello."]], "emoteWellPlayed": [["Geras ritmas!", "Good rhythm!"], ["Gražus solo!", "Lovely solo!"], ["Pataikei į taktą!", "Right on the beat!"], ["Oho! Dar kartą!", "Whoa! Do it again!"], ["Tau – plojimai!", "A round of applause for you!"]], "emoteThreat": [["Tuoj grosi mano orkestre.", "You will be playing in my band soon."], ["Tavo kaulai gražiai barškės.", "Your bones will rattle nicely."], ["Jau matuoju tau uniformą.", "I am already measuring your uniform."], ["Paskutinis taktas tavo!", "The last beat is yours!"], ["Miręs grosi geriau.", "You will play better dead."]], "emoteThanks": [["Dėkui, bičiuli!", "Thanks, friend!"], ["Ačiū, ačiū!", "Thank you, thank you!"], ["Širdingai! Jei turėčiau širdį.", "From the heart! If I had one."], ["Tu šaunuolis!", "You are a good one!"], ["Dėkui! Būgnu nusilenkiu.", "Thanks! I bow with my drum."]], "emoteOops": [["Oi. Pro šalį.", "Oops. Missed."], ["Iškrito žandikaulis.", "My jaw fell off."], ["Klaida? Ne, improvizacija!", "A mistake? No, improvisation!"], ["Ne tas būgnas.", "Wrong drum."], ["Pamečiau ritmą. Ir koją.", "I lost the rhythm. And a leg."]], "timer": [["Tik-tak, tik-tak! Laikykis tempo!", "Tick-tock, tick-tock! Keep the tempo!"], ["Tempą, tempą!", "Tempo, tempo!"], ["Orkestras laukia tavęs!", "The band is waiting for you!"], ["Aš turiu laiko. Tu – ne!", "I have time. You do not!"], ["Trys, keturi – ir!", "Three, four – and!"]]}, "stygu-mage": {"emoteHello": [["Sveikas.", "Greetings."], ["Jaučiu tavo šilumą. Ji dreba.", "I feel your warmth. It trembles."], ["Stichijos tave sveikina. Kol kas.", "The elements greet you. For now."], ["Labas vakaras.", "Good evening."], ["Taigi tai tu.", "So it is you."]], "emoteWellPlayed": [["Aštru kaip žaibas.", "Sharp as lightning."], ["Hm. Turi nuojautą.", "Hm. You have instinct."], ["Tokį burtą pasirašyčiau.", "I would put my name to that spell."], ["Tiksliai. Pripažįstu.", "Precise. I concede."], ["Gražiai sužaibavo.", "That struck beautifully."]], "emoteThreat": [["Tavo liepsna maža.", "Your flame is small."], ["Sušaldysiu tau kraują.", "I will freeze the blood in you."], ["Jauti, kaip kaista oras? Tai tau.", "Feel the air heating? That is for you."], ["Tuoj virsi pelenais.", "You are about to be ash."], ["Vienas žaibas – ir tavęs nėra.", "One bolt, and you are gone."]], "emoteThanks": [["Dėkoju.", "Thank you."], ["Priimu.", "Accepted."], ["Mandagu. Vertinu.", "Courteous. Appreciated."], ["Ačiū. Nuoširdžiai.", "Thank you. Sincerely."], ["Tai neliks be atsako.", "It will not go unanswered."]], "emoteOops": [["Ne ta stichija.", "Wrong element."], ["Kibirkštis užgeso.", "The spark went out."], ["Iš naujo.", "Again."], ["Hm. Vėjas pasisuko.", "Hm. The wind turned."], ["Net audros kartais prašauna. Aš – retai.", "Even storms miss at times. I seldom do."]], "timer": [["Greičiau.", "Faster."], ["Audra nelaukia.", "The storm does not wait."], ["Spręsk.", "Decide."], ["Ledas tirpsta, kol tu galvoji.", "The ice melts while you think."], ["Mano kantrybė trumpesnė už žaibą.", "My patience is shorter than a lightning bolt."]]}, "tylos-mokinys": {"emoteHello": [["Sveikas.", "Hello."], ["Labas.", "Hello."], ["Ramybės.", "Peace."], ["Girdžiu tave.", "I hear you."], ["Sveikinu.", "Greetings."]], "emoteWellPlayed": [["Tikslu.", "Precise."], ["Gražu.", "Beautiful."], ["Švaru.", "Clean."], ["Gerbiu.", "Respect."], ["Mokytojas pagirtų.", "The master would approve."]], "emoteThreat": [["Tavęs niekas neišgirs.", "No one will hear you."], ["Girdžiu tavo baimę.", "I hear your fear."], ["Paskutinis tavo garsas.", "Your last sound."], ["Nutilsi.", "You will fall silent."], ["Vienas kirtis.", "One strike."]], "emoteThanks": [["Dėkoju.", "Thank you."], ["Ačiū.", "Thank you."], ["Priimu.", "Accepted."], ["Dėkingas.", "Grateful."], ["Gerai.", "Good."]], "emoteOops": [["Klaida.", "A mistake."], ["Ne taip.", "Not like that."], ["Dar ne meistras.", "Not a master yet."], ["Per greit.", "Too fast."], ["Atleisk.", "Forgive me."]], "timer": [["Laikas.", "Time."], ["Spręsk.", "Decide."], ["Smėlis.", "The sand."], ["Lauki per ilgai.", "You wait too long."], ["Judėk.", "Move."]]}, "kapitone": {"emoteHello": [["Ahoj, sausumos žiurke!", "Ahoy, land rat!"], ["Ahoj!", "Ahoy!"], ["Gražus laivelis. Būtų gaila.", "Pretty little boat. Would be a shame."], ["Sveikas! Kiek turi aukso?", "Hello! How much gold have you got?"], ["Labas, drauguži!", "Hello, matey!"]], "emoteWellPlayed": [["Neblogai, jūrininke.", "Not bad, sailor."], ["Tiktum mano įgulai.", "You would fit in my crew."], ["Gudrus manevras!", "Clever manoeuvre!"], ["Gerai vairuoji.", "You steer well."], ["Už tai – gurkšnis romo!", "A swig of rum for that!"]], "emoteThreat": [["Eisi lenta.", "You will walk the plank."], ["Rykliai jau alkani.", "The sharks are already hungry."], ["Tavo laivas gražiai degs.", "Your ship will burn nicely."], ["Atiduok vairą. Paskutinį kartą prašau.", "Give up the helm. I am asking for the last time."], ["Užtaisyt patrankas!", "Load the cannons!"]], "emoteThanks": [["Ačiū, bičiuli!", "Thanks, mate!"], ["Dėkui. Vis tiek apiplėšiu.", "Thanks. I will still rob you."], ["Ačiū! Romas mano sąskaita.", "Thanks! The rum is on me."], ["Geras tu žmogus!", "You are a good sort!"], ["Kapitonė dėkoja.", "The captain thanks you."]], "emoteOops": [["Velnias. Ne tas kursas.", "Damn. Wrong course."], ["Kas laikė žemėlapį aukštyn kojom?", "Who was holding the map upside down?"], ["Užplaukiau ant seklumos.", "I ran aground."], ["Taip ir planavau. Beveik.", "I planned it that way. Nearly."], ["Ne ta burė.", "Wrong sail."]], "timer": [["Greičiau! Potvynis nelaukia!", "Faster! The tide will not wait!"], ["Vėjas keičiasi!", "The wind is turning!"], ["Miegi vachtoje?", "Asleep on watch?"], ["Aš pasensiu belaukdama.", "I will grow old waiting."], ["Inkarą aukštyn, greičiau!", "Anchor up, quickly!"]]}, "seseliu-kisenvagis": {"emoteHello": [["Labas. Gražus žiedas.", "Hello. Nice ring."], ["Labas! Nieko nepasigedai?", "Hello! Missing anything?"], ["Ei. Čia aš.", "Hey. It is me."], ["Sveikas. Graži piniginė.", "Hello. Nice purse."], ["Susitikom. Atsitiktinai, žinoma.", "We meet. By chance, of course."]], "emoteWellPlayed": [["Vikru. Gerbiu.", "Nimble. Respect."], ["Švariai nušvilpta.", "Cleanly lifted."], ["Šito triuko nežinojau.", "I did not know that trick."], ["Tu tikrai ne iš gildijos?", "Are you sure you are not from the guild?"], ["Gražiai. Pavogsiu idėją.", "Nice. I am stealing the idea."]], "emoteThreat": [["Miegok viena akimi.", "Sleep with one eye open."], ["Žinau, kur miegi.", "I know where you sleep."], ["Rytoj neturėsi nė batų.", "Tomorrow you will not even have boots."], ["Tavo kišenės jau tuščios.", "Your pockets are already empty."], ["Šešėliai tave stebi.", "The shadows are watching you."]], "emoteThanks": [["Ačiū. Grąžinsiu. Gal.", "Thanks. I will give it back. Maybe."], ["Dėkui! Skolingas nebūsiu. Pavogsiu.", "Thanks! I will not owe you. I will steal it."], ["Ačiū. Tik niekam nesakyk.", "Thanks. Just tell no one."], ["Malonu, malonu.", "Much obliged."], ["Geradarys. Reta rūšis.", "A benefactor. A rare breed."]], "emoteOops": [["Oi. Ne ta kišenė.", "Oops. Wrong pocket."], ["Ups. Girgždėjo.", "Oops. That creaked."], ["Tai ne tai, ką galvoji.", "It is not what you think."], ["Ne tas raktas.", "Wrong key."], ["Užkliuvau už savo apsiausto.", "I tripped over my own cloak."]], "timer": [["Greičiau, sargyba ateina!", "Hurry, the guards are coming!"], ["Greičiau, aušta!", "Hurry, dawn is coming!"], ["Žingsniai. Girdžiu žingsnius.", "Footsteps. I hear footsteps."], ["Mes čia per ilgai.", "We have been here too long."], ["Net spynas greičiau atrakinu.", "I pick locks faster than this."]]}, "ausros-riteris": {"emoteHello": [["Sveikas, kary.", "Greetings, warrior."], ["Garbė tave matyti.", "An honour to meet you."], ["Šviesios dienos!", "A bright day to you!"], ["Sveikinu vertą varžovą.", "I greet a worthy opponent."], ["Tebūnie kova garbinga.", "May the fight be honourable."]], "emoteWellPlayed": [["Garbinga kova.", "An honourable fight."], ["Riterio vertas ėjimas.", "A move worthy of a knight."], ["Puikiai. Lenkiu galvą.", "Excellent. I bow my head."], ["Stipru ir sąžininga.", "Strong and fair."], ["Taip kovojama garbingai.", "That is how one fights with honour."]], "emoteThreat": [["Šviesa tave suras.", "The light will find you."], ["Pasiduok, kol dar gali.", "Yield while you still can."], ["Tamsa visada pralaimi.", "Darkness always loses."], ["Mano kardas nepavargsta.", "My sword does not tire."], ["Aušra tau nebus maloni.", "The dawn will not be kind to you."]], "emoteThanks": [["Dėkoju iš širdies.", "My heartfelt thanks."], ["Ačiū, bičiuli.", "Thank you, friend."], ["Esu tau dėkingas.", "I am in your debt."], ["Geras darbas neliks pamirštas.", "A good deed will not be forgotten."], ["Šviesa tau atlygins.", "The light will reward you."]], "emoteOops": [["Atleisk. Suklydau.", "Forgive me. I erred."], ["Mano klaida. Prisiimu.", "My mistake. I own it."], ["Kardas nuslydo.", "The sword slipped."], ["Tai nepasikartos.", "It will not happen again."], ["Net riteriai suklumpa.", "Even knights stumble."]], "timer": [["Nedelsk. Aušra arti.", "Do not delay. The dawn is near."], ["Sprendimo metas.", "It is time to decide."], ["Drąsa nelaukia.", "Courage does not wait."], ["Pirmyn. Abejonės – tamsos ginklas.", "Onward. Doubt is a weapon of the dark."], ["Saulė jau kyla.", "The sun is already rising."]]}, "varpu-gydytoja": {"emoteHello": [["Sveikas. Kaip jautiesi?", "Hello. How are you feeling?"], ["Labas, mielas.", "Hello, dear."], ["Sveikas. Atrodai išbalęs.", "Hello. You look pale."], ["Ramybė šiems namams.", "Peace upon this house."], ["Gera tave matyti sveiką.", "Good to see you well."]], "emoteWellPlayed": [["Gražiai sužaista.", "Well played."], ["Protinga galva.", "A wise head."], ["Tiksliai kaip siūlė.", "Precise as a stitch."], ["Gražu žiūrėti.", "A pleasure to watch."], ["Šito išmokyčiau mokines.", "I would teach that to my pupils."]], "emoteThreat": [["Kai kurių žaizdų negydau.", "Some wounds I do not heal."], ["Žinau, kur kaulas silpniausias.", "I know where the bone is weakest."], ["Šita žaizda neužgis.", "This wound will not close."], ["Varpas tuoj skambės tau.", "The bell is about to ring for you."], ["Aš moku ne tik siūti.", "Stitching is not all I can do."]], "emoteThanks": [["Ačiū tau.", "Thank you."], ["Dėkui, vaike.", "Thank you, child."], ["Gera širdis.", "A kind heart."], ["Priimu su dėkingumu.", "Accepted with gratitude."], ["Ačiū. Užeik arbatos.", "Thank you. Come by for tea."]], "emoteOops": [["Oi. Ne tas tepalas.", "Oh. The wrong ointment."], ["Ne tas buteliukas.", "Wrong bottle."], ["Nieko. Perrišim.", "No matter. We will redo the dressing."], ["Rankos jau nebe tos.", "My hands are not what they were."], ["Atleisk senai moteriai.", "Forgive an old woman."]], "timer": [["Paskubėk, mielasis.", "Hurry along, dear."], ["Žaizda nelaukia.", "A wound will not wait."], ["Na, drąsiau.", "Go on, be brave."], ["Delsimas kainuoja gyvybes.", "Delay costs lives."], ["Varpas tuoj muš valandą.", "The bell is about to strike the hour."]]}, "gaujos-vadas": {"emoteHello": [["Ei, tu!", "Hey, you!"], ["Hrr! Sveikas!", "Hrr! Hello!"], ["Tu kas?", "Who are you?"], ["Ei, mažiuk!", "Hey, little one!"], ["Vadas sako labas!", "The boss says hello!"]], "emoteWellPlayed": [["Tu stiprus. Vadas gerbia.", "You strong. Boss respects."], ["Geras smūgis. Kaip orko.", "Good hit. Like an orc's."], ["Cha! Patiko!", "Ha! I liked that!"], ["Tu ne toks silpnas.", "You are not so weak."], ["Vadas ploja!", "The boss claps!"]], "emoteThreat": [["Sulaužysiu kaip šakelę.", "I will snap you like a twig."], ["SUVALGYSIU!", "I WILL EAT YOU!"], ["Tavo galva – ant mieto.", "Your head goes on a stake."], ["Bėk. Mėgstu, kai bėga.", "Run. I like it when they run."], ["Gauja jau alkana.", "The warband is hungry."]], "emoteThanks": [["Gerai. Dėkui.", "Good. Thanks."], ["Hrm. Ačiū.", "Hrm. Thanks."], ["Vadas neužmirš!", "The boss will not forget!"], ["Gausi kaulą!", "You get a bone!"], ["Tu geras. Nevalgysiu.", "You are good. I will not eat you."]], "emoteOops": [["Ė? Ne ten.", "Eh? Not there."], ["Ugh. Kuoka nuslydo.", "Ugh. The club slipped."], ["Ė? Kur jis dingo?", "Eh? Where did it go?"], ["Tylėk. Nieko nebuvo.", "Quiet. Nothing happened."], ["Trenkiau savam!", "I hit one of my own!"]], "timer": [["GREIČIAU!", "FASTER!"], ["MUŠK JAU!", "HIT ALREADY!"], ["Vadas nemėgsta laukti.", "The boss does not like waiting."], ["Galvoji? Nustok!", "Thinking? Stop it!"], ["LĖTAS KAIP SRAIGĖ!", "SLOW AS A SNAIL!"]]}, "pelkiu-ziniuone": {"emoteHello": [["Labukas!", "Hello-o!"], ["Sveikas, varliuk.", "Hello, froggy."], ["O! Svečias!", "Oh! A guest!"], ["La-bas, la-bas!", "Hel-lo, hel-lo!"], ["Valgęs? Turiu sriubos.", "Have you eaten? I have soup."]], "emoteWellPlayed": [["Gudrus kaip pelkės žaltys.", "Sly as a bog snake."], ["Hi hi! Suktas!", "Hee hee! Tricky!"], ["Varlė tau linkteli.", "The frog nods to you."], ["Net aš taip nesugalvočiau!", "Even I would not have thought of that!"], ["Gud-ru-tis!", "Cle-ver thing!"]], "emoteThreat": [["Jau verdu tau sriubą.", "I am already cooking your soup."], ["Tavo ausys gražiai virs.", "Your ears will boil nicely."], ["Pelkė jau čiulpia tavo batus.", "The swamp is already sucking at your boots."], ["Kvaksėsi iki ryto!", "You will croak till morning!"], ["Paragavau tavo šešėlio. Kartus.", "I tasted your shadow. Bitter."]], "emoteThanks": [["Ačiū, balandėli.", "Thank you, dearie."], ["Ačiū, ačiū!", "Thank you, thank you!"], ["Duosiu tau grybą.", "I will give you a mushroom."], ["Geras vaikas!", "Good child!"], ["Dėė-kui!", "Thaaank you!"]], "emoteOops": [["Oi. Ne tas grybas.", "Oops. Wrong mushroom."], ["Kur padėjau akinius?", "Where did I put my spectacles?"], ["Supainiojau puodus.", "I mixed up the pots."], ["Tai varlė kalta.", "It was the frog's fault."], ["Oi! Sprogs!", "Oh! It will blow!"]], "timer": [["Greičiau, sriuba atauš!", "Hurry, the soup is getting cold!"], ["Aš sena, neturiu tiek laiko!", "I am old, I do not have that long!"], ["Grybai greičiau auga!", "Mushrooms grow faster!"], ["Tik-tak, kvar-kvar!", "Tick-tock, croak-croak!"], ["Užmigsiu belaukdama.", "I will nod off waiting."]]}, "arenos-cempionas": {"emoteHello": [["Sveikinu savo gerbėją!", "Greetings to my fan!"], ["Taip, tai aš.", "Yes, it is me."], ["Sveiki, mano mylimi žiūrovai!", "Welcome, my beloved spectators!"], ["Nori autografo?", "Want an autograph?"], ["Labas. Tu mane žinai.", "Hello. You know who I am."]], "emoteWellPlayed": [["Geras šou. Beveik kaip mano.", "A good show. Almost as good as mine."], ["Neblogai. Publikai patiko.", "Not bad. The crowd liked it."], ["Bravo! Tikrai, bravo!", "Bravo! Truly, bravo!"], ["Mokaisi iš geriausio.", "You are learning from the best."], ["Tokį ėjimą rodyčiau finale!", "I would save a move like that for the final!"]], "emoteThreat": [["Tuoj tave išneš ant skydo.", "They will carry you out on a shield."], ["Tavo paskutinis pasirodymas!", "Your final performance!"], ["Minia nori kraujo. Tavo.", "The crowd wants blood. Yours."], ["Šypsokis – krisi gražiai.", "Smile – you will fall beautifully."], ["Nusibodai. Baigiam.", "You bore me. Let us finish."]], "emoteThanks": [["Ačiū, ačiū! Jūs nuostabūs!", "Thank you, thank you! You are wonderful!"], ["Žinau, kad esu nuostabus. Bet ačiū.", "I know I am wonderful. But thank you."], ["Lenkiuosi!", "I take a bow!"], ["Bilietas kitam kartui – nemokamai!", "A free ticket for next time!"], ["Ačiū, drauge.", "Thank you, friend."]], "emoteOops": [["Tai... buvo suplanuota.", "That... was planned."], ["Tai... repeticija.", "That was... a rehearsal."], ["Daviau tau šansą. Tyčia.", "I gave you a chance. On purpose."], ["Slidus smėlis!", "Slippery sand!"], ["Nežiūrėkit! Dar nepasiruošęs!", "Do not look! I am not ready!"]], "timer": [["Publika nuobodžiauja!", "The crowd is getting bored!"], ["Žiūrovai žiovauja!", "The spectators are yawning!"], ["Aš jau būčiau laimėjęs. Dukart.", "I would have won by now. Twice."], ["Veiksmo! Jie nori veiksmo!", "Action! They want action!"], ["Sustingai iš baimės?", "Frozen with fear?"]]}, "varnu-pranase": {"emoteHello": [["Žinojau, kad ateisi.", "I knew you would come."], ["Sapnavau tave.", "I dreamed of you."], ["Sveikas. Pagaliau.", "Hello. At last."], ["Vėluoji viena diena.", "You are one day late."], ["Varnos tave pasveikino pirmos.", "The ravens greeted you first."]], "emoteWellPlayed": [["To nenumačiau. Sveikinu.", "I did not foresee that. Well done."], ["Netikėta. Reta.", "Unexpected. Rare."], ["Tu perrašei mano regėjimą.", "You rewrote my vision."], ["Varnos sutriko. Tai pagyrimas.", "The ravens are confused. That is praise."], ["Gražus posūkis.", "A beautiful turn."]], "emoteThreat": [["Mačiau tavo pabaigą.", "I have seen your end."], ["Trys ėjimai. Tiek tau liko.", "Three moves. That is all you have left."], ["Tavo gija plona.", "Your thread is thin."], ["Varnos jau renkasi.", "The ravens are already gathering."], ["Nežiūrėk atgal. Vėlu.", "Do not look back. It is too late."]], "emoteThanks": [["Dėkoju.", "Thank you."], ["Žinojau, kad taip pasielgsi.", "I knew you would do that."], ["Ačiū. Tai irgi mačiau.", "Thank you. I saw that too."], ["Varnos prisimins.", "The ravens will remember."], ["Gerumas keičia gijas.", "Kindness changes the threads."]], "emoteOops": [["Hm. Regėjimas buvo miglotas.", "Hm. The vision was hazy."], ["Ne ta ateitis.", "The wrong future."], ["Varnos nutylėjo.", "The ravens kept silent."], ["Net pranašės apsirinka.", "Even prophetesses misjudge."], ["Hm. Tai turėjo įvykti rytoj.", "Hm. That was meant to happen tomorrow."]], "timer": [["Smėlis baigia byrėti.", "The sand is nearly gone."], ["Aš jau žinau, ką pasirinksi.", "I already know what you will choose."], ["Laikas siaurėja.", "Time is narrowing."], ["Rinkis. Abi gijos trumpos.", "Choose. Both threads are short."], ["Likimas nelaukia.", "Fate does not wait."]]}}}