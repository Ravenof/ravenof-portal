{
  "name": "ravenof-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "next build && npx cap sync android",
    "cap:open": "npx cap open android",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "cards:i18n": "node tools/cards-i18n.mjs",
    "i18n:scan": "node scripts/i18n-scan-lt.mjs",
    "i18n:check": "node scripts/i18n-validate.mjs && node scripts/i18n-scan-lt.mjs",
    "e2e:i18n": "playwright test e2e/i18n.spec.ts",
    "e2e:en": "playwright test e2e/english-localization.spec.ts",
    "progression:check": "node scripts/progression-check.mjs",
    "progression:test": "node supabase/tests/run.mjs",
    "progression:test:shape": "node --experimental-strip-types scripts/progression-shape-test.mjs",
    "game:test:chain": "tsx scripts/simulate-battlecry-chain.ts",
    "quests:check": "node scripts/quests-check.mjs",
    "handoff:gen": "node scripts/gen-handoff-registries.mjs",
    "handoff:check": "node scripts/handoff-check.mjs",
    "game:test:targets": "node scripts/test-target-selection.mjs",
    "game:test:keywords": "node scripts/test-keyword-detection.mjs",
    "game:test:battlecry": "node scripts/test-battlecry-summon.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "game:test:newtriggers": "npx tsx scripts/simulate-new-triggers.ts",
    "game:test:targetcheck": "npx tsx scripts/simulate-target-validation.ts",
    "game:test:extraatk": "npx tsx scripts/simulate-extra-attacks.ts",
    "game:test:castgrave": "npx tsx scripts/simulate-cast-from-grave.ts",
    "game:test:champswap": "npx tsx scripts/simulate-champ-swap.ts",
    "game:test:sametarget": "npx tsx scripts/simulate-then-sametarget.ts",
    "game:test:feel": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/simulate-game-feel.ts",
    "game:test:mullfat": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/simulate-mulligan-fatigue.ts",
    "game:test:champtarget": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/simulate-champ-target-adv.ts",
    "game:test:aidiff": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/simulate-ai-difficulty.ts",
    "game:test:selftarget": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/simulate-spell-selftarget.ts",
    "game:test:qa": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/simulate-qa-fixes.ts",
    "tutorial:check": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/tutorial-v3-check.ts",
    "tutorial:voice": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/tutorial-voice-export.ts",
    "tutorial:voice:gen": "node tools/tutorial-voice-generate.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.4",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.511.0",
    "next": "15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.8",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
