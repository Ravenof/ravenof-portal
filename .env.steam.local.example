# Nukopijuok i .env.steam.local (jis i git nekeliamas) ir uzpildyk gavus tikra App ID.
STEAM_APP_ID=480
STEAM_DEPOT_ID=481
# Steam paskyra su teise ikelti build'us (rekomenduojama atskira, be piniginiu teisiu)
STEAM_BUILD_USER=kaukasgames
# Jei steamcmd.exe ne PATH'e:
# STEAMCMD=C:\steamcmd\steamcmd.exe
